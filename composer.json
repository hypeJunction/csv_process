{
    "name": "hypejunction/csv_process",
    "type": "elgg-plugin",
    "description": "Provides an interface for uploading/processing CSVs with custom callbacks for other plugins",
    "homepage": "https://github.com/hypeJunction/csv_process",
    "keywords": [
        "elgg",
        "plugin",
        "csv",
        "import"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Matt Beckett",
            "email": "matt@arckinteractive.com"
        },
        {
            "name": "Ismayil Khayredinov",
            "email": "info@hypejunction.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "php": ">=8.3",
        "elgg/elgg": "~7.0.0",
        "ext-intl": "*"
    },
    "autoload": {
        "psr-4": {
            "CsvProcess\\": "classes/CsvProcess/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "installer-name": "csv_process",
        "elgg-plugin": {
            "id": "csv_process"
        }
    }
}
